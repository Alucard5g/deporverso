# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DEPORVERSO ARCHITECTURE CONFIGURATION
PORT=3000
NODE_ENV="production"

# PostgreSQL Multi-Tenant Database (Google Cloud SQL / Neon / Supabase)
DATABASE_URL="postgresql://deporverso_admin:password@localhost:5432/deporverso_db?sslmode=prefer"
PGHOST="localhost"
PGPORT=5432
PGUSER="deporverso_admin"
PGPASSWORD="supersecretpassword"
PGDATABASE="deporverso_db"
PGSSLMODE="prefer"

# Firebase Admin SDK Configuration (Cloud Run Default or Service Account)
FIREBASE_PROJECT_ID="deporverso-prod"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@deporverso-prod.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL="https://deporverso-prod-default-rtdb.firebaseio.com"

# Heroes del Deporte Gamification Bridge
HEROES_DEL_DEPORTE_API_URL="https://api.heroesdeldeporte.com/v1"
HEROES_DEL_DEPORTE_WEBHOOK_SECRET="whsec_deporverso_heroes_prod_key_77"
HEROES_VR_TELEMETRY_KEY="vr_telemetry_shared_secret_2026"

# Storage Bucket for VAR Clips & Merch Assets (Cloudflare R2 / GCS)
VAR_STORAGE_BUCKET="deporverso-var-clips"
VAR_STORAGE_CDN_URL="https://cdn.deporverso.com/var"

