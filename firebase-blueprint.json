{
  "entities": {
    "tenant": {
      "title": "Tenant",
      "description": "Multitenant sports league organization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "subdomain": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "pro", "enterprise"] },
        "primarySport": { "type": "string" },
        "supportedSports": { "type": "array" },
        "colors": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "plan"]
    },
    "match": {
      "title": "Match",
      "description": "Sports fixture and live match state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "sportId": { "type": "string" },
        "homeTeam": { "type": "string" },
        "awayTeam": { "type": "string" },
        "homeScore": { "type": "number" },
        "awayScore": { "type": "number" },
        "status": { "type": "string", "enum": ["SCHEDULED", "LIVE", "HALFTIME", "FINISHED", "CANCELLED"] },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "field": { "type": "string" },
        "referee": { "type": "string" }
      },
      "required": ["id", "tenantId", "homeTeam", "awayTeam", "status"]
    },
    "player": {
      "title": "Player",
      "description": "Athlete registered in the league",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "team": { "type": "string" },
        "number": { "type": "number" },
        "position": { "type": "string" },
        "sport": { "type": "string" },
        "goals": { "type": "number" },
        "assists": { "type": "number" },
        "yellowCards": { "type": "number" },
        "redCards": { "type": "number" }
      },
      "required": ["id", "tenantId", "name", "team"]
    },
    "chronicle": {
      "title": "Chronicle",
      "description": "AI-generated sports journalistic article",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "matchId": { "type": "string" },
        "title": { "type": "string" },
        "headline": { "type": "string" },
        "content": { "type": "string" },
        "sport": { "type": "string" },
        "author": { "type": "string" },
        "createdAt": { "type": "string" },
        "published": { "type": "boolean" }
      },
      "required": ["id", "title", "content"]
    },
    "event": {
      "title": "Event",
      "description": "Match event logged during vocalia digital",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "matchId": { "type": "string" },
        "tenantId": { "type": "string" },
        "type": { "type": "string" },
        "minute": { "type": "number" },
        "team": { "type": "string" },
        "player": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "matchId", "type"]
    },
    "test": {
      "title": "TestDoc",
      "description": "Test doc to verify Firestore connectivity",
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "ping": { "type": "string" }
      }
    },
    "vocalia_report": {
      "title": "VocaliaReport",
      "description": "Live match vocalia digital report tied to a tenant subdomain",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "matchId": { "type": "string" },
        "tenantId": { "type": "string" },
        "subdomain": { "type": "string" },
        "domain": { "type": "string" },
        "sportCode": { "type": "string" },
        "homeTeam": { "type": "string" },
        "awayTeam": { "type": "string" },
        "homeScore": { "type": "number" },
        "awayScore": { "type": "number" },
        "status": { "type": "string" },
        "vocalName": { "type": "string" },
        "refereeName": { "type": "string" },
        "savedAt": { "type": "string" }
      },
      "required": ["id", "matchId", "tenantId", "status"]
    },
    "player_transfer": {
      "title": "PlayerTransfer",
      "description": "Official player transfer and clearance pass between league clubs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "playerId": { "type": "string" },
        "playerName": { "type": "string" },
        "playerCedula": { "type": "string" },
        "originTeamId": { "type": "string" },
        "originTeamName": { "type": "string" },
        "destinationTeamId": { "type": "string" },
        "destinationTeamName": { "type": "string" },
        "transferType": { "type": "string", "enum": ["DEFINITIVO", "PRESTAMO", "LIBRE", "INTERLIGA"] },
        "status": { "type": "string", "enum": ["PENDIENTE_ORIGEN", "PENDIENTE_DESTINO", "PENDIENTE_LIGA", "APROBADO", "RECHAZADO"] },
        "transferFee": { "type": "number" },
        "requestDate": { "type": "string" },
        "approvalDate": { "type": "string" },
        "originApproved": { "type": "boolean" },
        "destinationApproved": { "type": "boolean" },
        "leagueApproved": { "type": "boolean" },
        "resolutionNumber": { "type": "string" },
        "certificateCode": { "type": "string" }
      },
      "required": ["id", "tenantId", "playerId", "originTeamId", "destinationTeamId", "status"]
    }
  },
  "firestore": {
    "/tenants/{tenantId}": {
      "schema": "tenant",
      "description": "Tenant league profile and configurations"
    },
    "/transfers/{transferId}": {
      "schema": "player_transfer",
      "description": "Official player transfer certificates, multi-party approvals, and audit trail"
    },
    "/matches/{matchId}": {
      "schema": "match",
      "description": "Matches scheduled and played across all sports"
    },
    "/vocalia_reports/{reportId}": {
      "schema": "vocalia_report",
      "description": "Official live digital vocalia reports detailed by league subdomain and persisted in real time"
    },
    "/players/{playerId}": {
      "schema": "player",
      "description": "Player profile and performance metrics"
    },
    "/chronicles/{chronicleId}": {
      "schema": "chronicle",
      "description": "AI-generated sports journalistic chronicles and summaries"
    },
    "/events/{eventId}": {
      "schema": "event",
      "description": "In-game events, goals, penalties, cards recorded via digital vocalia"
    },
    "/test/{testId}": {
      "schema": "test",
      "description": "Test collection for server connection verification"
    }
  }
}
