rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidTenant(data) {
      return data.id is string &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 100;
    }

    function isValidMatch(data) {
      return data.id is string &&
             data.tenantId is string &&
             data.homeTeam is string &&
             data.awayTeam is string &&
             data.status in ['SCHEDULED', 'LIVE', 'HALFTIME', 'FINISHED', 'CANCELLED'];
    }

    function isValidPlayer(data) {
      return data.id is string &&
             data.tenantId is string &&
             data.name is string &&
             data.team is string;
    }

    function isValidChronicle(data) {
      return data.id is string &&
             data.title is string &&
             data.title.size() > 0 &&
             data.content is string;
    }

    function isValidEvent(data) {
      return data.id is string &&
             data.matchId is string &&
             data.type is string;
    }

    function isValidVocaliaReport(data) {
      return data.id is string &&
             data.matchId is string &&
             data.tenantId is string;
    }

    function isValidTransfer(data) {
      return data.id is string &&
             data.tenantId is string &&
             data.playerId is string &&
             data.originTeamId is string &&
             data.destinationTeamId is string &&
             data.status in ['PENDIENTE_ORIGEN', 'PENDIENTE_DESTINO', 'PENDIENTE_LIGA', 'APROBADO', 'RECHAZADO'];
    }

    // Colección de Organizaciones Deportivas / Ligas
    match /tenants/{tenantId} {
      allow read: if true;
      allow create, update: if request.resource.data.id == tenantId && isValidTenant(request.resource.data);
      allow delete: if request.auth != null;
    }

    // Partidos y Marcadores en Vivo (Lectura pública para fan zone y pantallas, escritura controlada)
    match /matches/{matchId} {
      allow read: if true;
      allow create, update: if request.resource.data.id == matchId && isValidMatch(request.resource.data);
      allow delete: if request.auth != null;
    }

    // Informes de Vocalía Digital en Vivo (Detallados por subdominio y agregados para el admin)
    match /vocalia_reports/{reportId} {
      allow read: if true;
      allow create, update: if request.resource.data.id == reportId && isValidVocaliaReport(request.resource.data);
      allow delete: if request.auth != null;
    }

    // Jugadores y Estadísticas
    match /players/{playerId} {
      allow read: if true;
      allow create, update: if request.resource.data.id == playerId && isValidPlayer(request.resource.data);
      allow delete: if request.auth != null;
    }

    // Pases y Transferencias Oficiales entre Clubes con Visto Bueno Digital
    match /transfers/{transferId} {
      allow read: if true;
      allow create, update: if request.resource.data.id == transferId && isValidTransfer(request.resource.data);
      allow delete: if request.auth != null;
    }

    // Crónicas Periodísticas IA y Noticias
    match /chronicles/{chronicleId} {
      allow read: if true;
      allow create, update: if request.resource.data.id == chronicleId && isValidChronicle(request.resource.data);
      allow delete: if request.auth != null;
    }

    // Eventos de Vocalía Digital en Tiempo Real
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if request.resource.data.id == eventId && isValidEvent(request.resource.data);
      allow delete: if request.auth != null;
    }

    // Actas e Incidentes de Video Arbitraje (VAR) y Evidencias Forenses
    match /var_incidents/{incidentId} {
      allow read, write: if true;
    }

    function isSuperAdminEmail() {
      return request.auth != null &&
             request.auth.token.email == 'roly3d.rg@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    function isValidAppUser(data) {
      return data.keys().hasAll(['id', 'email', 'name', 'role', 'status', 'createdAt']) &&
             data.keys().hasOnly(['id', 'email', 'name', 'role', 'status', 'tenantId', 'passwordHash', 'createdAt', 'updatedAt', 'lastLogin']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.email is string && data.email.size() > 3 && data.email.size() <= 160 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.role in ['SUPER_ADMIN', 'LEAGUE_ADMIN', 'SCOUT', 'TEAM_DELEGATE', 'REFEREE'] &&
             data.status in ['ACTIVO', 'SUSPENDIDO'] &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('tenantId' in data) || (data.tenantId is string && data.tenantId.size() <= 128)) &&
             (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() <= 256)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
             (!('lastLogin' in data) || (data.lastLogin is string && data.lastLogin.size() <= 64));
    }

    // Colección de verificación de conectividad
    match /test/{testId} {
      allow read, write: if true;
    }

    // Usuarios administrados por el SuperAdmin (blindado contra lectura o escritura pública)
    match /app_users/{userId} {
      allow get, list: if isSuperAdminEmail();
      allow create: if isSuperAdminEmail() &&
                       request.resource.data.id == userId &&
                       isValidAppUser(request.resource.data);
      allow update: if isSuperAdminEmail() &&
                       request.resource.data.id == userId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       isValidAppUser(request.resource.data);
      allow delete: if isSuperAdminEmail() &&
                       resource.data.email != 'roly3d.rg@gmail.com';
    }
  }
}
